# Copy this file to .env and fill in your values.
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env
# Commit .env.example. NEVER commit .env.
# ASP.NET Core uses appsettings.json instead of this file.

# Port the API runs on. Use your module's suggested port from docs/integration.md.
PORT=8000

# Frontend URLs allowed to call this API (CORS), separated by commas.
CORS_ORIGINS=http://localhost:5173

# Finals: database connection string
# DATABASE_URL=
